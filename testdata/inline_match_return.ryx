## Inline match+return regression (Phase 22)

enum Color
  Red
  Green
  Blue
end

def score(c: Color) -> i64
  match c
    Red
      return 1
    Green
      return 2
    Blue
      return 3
    _
      return 0
  end
end

def main() -> i64
  let n = score(Green) + score(Red) + score(Blue)
  print_i64(n)
  return 0
end
