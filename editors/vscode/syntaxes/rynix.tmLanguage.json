{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rynix",
  "scopeName": "source.rynix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-rynix",
          "match": "##.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rynix",
          "match": "\\b(def|let|mut|if|else|elif|loop|break|continue|match|return|end|struct|enum|type|import|pub|spawn)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.rynix",
          "match": "\\b(i64|f64|bool|str|Vec|Map|nil)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rynix",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rynix", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rynix",
          "match": "\\b(0[xX][0-9a-fA-F_]+|[0-9_]+)\\b"
        }
      ]
    }
  }
}
