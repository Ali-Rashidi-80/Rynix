# Build artifacts
/target

# Rust / cargo
**/*.rs.bk
*.pdb

# Python
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# insta pending snapshots (accepted snapshots ARE committed)
*.pending-snap

# Fuzzing artifacts (the fuzz crate itself + seed_*.ryx corpora are committed)
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
/fuzz/corpus/**
!/fuzz/corpus/**/
!/fuzz/corpus/**/seed_*.ryx
!/fuzz/corpus/**/seed_*.rs
!/fuzz/corpus/**/seed_*.txt

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# VS Code extension build
/editors/vscode/node_modules
/editors/vscode/out
/editors/vscode/*.vsix

# Local benchmark scratch (binaries live under /target)
/*.exe
benchmarks/suite5/*_c.ll
benchmarks/suite5/run_output.txt
benchmarks/suite5/_patch_*.py
*.profraw
*.profdata

# Env / secrets
.env
.env.*
!.env.example
*.pem
credentials.json

# Local scratch / agent plans (tracked Skills under .agents/ stay committed)
.tmp/
.cursor/plans/
