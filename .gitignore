# Build artifacts
/target

# Rust / cargo
**/*.rs.bk
*.pdb

# Python
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# insta pending snapshots (accepted snapshots ARE committed)
*.pending-snap

# Fuzzing artifacts (the fuzz crate itself is committed)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# VS Code extension build
/editors/vscode/node_modules
/editors/vscode/out
/editors/vscode/*.vsix

# Local benchmark scratch (binaries live under /target)
/*.exe
benchmarks/suite5/*_c.ll
benchmarks/suite5/run_output.txt
benchmarks/suite5/_patch_*.py
*.profraw
*.profdata

# Env / secrets
.env
.env.*
!.env.example
*.pem
credentials.json
