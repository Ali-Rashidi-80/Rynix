{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rynix.dev/schemas/rynix.deps.v1.json",
  "title": "rynix.deps.v1",
  "type": "object",
  "required": ["schema", "manifest", "package", "status", "dependencies"],
  "properties": {
    "schema": { "const": "rynix.deps.v1" },
    "manifest": { "type": "string" },
    "package": { "type": "string" },
    "registry": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "path", "ok", "detail"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["path", "registry"] },
          "path": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "entry": { "type": ["string", "null"] },
          "ok": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "note": { "type": "string" }
  }
}
