@import_c("<stdio.h>")
@import_c("<stdlib.h>")

pub fn suite5_print_i64(n: i64) void {
  val env: *u8 = getenv("SUITE5_BENCH")
  if env != (0 as *u8) {
    mut sink: i64 = 0
    sink = n
    ret
  }
  printf("%lld\n", n)
  ret
}

pub fn main() i32 {
  mut acc: i64 = 0
  for i_idx in 10000000 {
    val i: i64 = i_idx as i64
    acc = acc + i * 31 - i / 8 + i % 13
  }
  suite5_print_i64(acc)
  ret 0
}
