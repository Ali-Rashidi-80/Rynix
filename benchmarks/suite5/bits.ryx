def popcount(x: i64) -> i64
  let mut v = x
  let mut c = 0
  loop
    if v == 0
      break
    end
    c += v & 1
    v = v >> 1
  end
  return c
end

def main() -> i64
  let n = 25000000
  let mut x = 1
  let mut acc = 0
  let mut i = 0
  loop
    if i >= n
      break
    end
    x = (x * 31 + i) % 1000000007
    acc += popcount(x)
    i += 1
  end
  print_i64(acc)
  return 0
end
