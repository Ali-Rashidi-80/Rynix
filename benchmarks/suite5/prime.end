@import_c("<stdio.h>")
@import_c("<stdlib.h>")

pub fn suite5_print_i64(n: i64) void {
  val env: *u8 = getenv("SUITE5_BENCH")
  if env != (0 as *u8) {
    mut sink: i64 = 0
    sink = n
    ret
  }
  printf("%lld\n", n)
  ret
}

pub fn main() i32 {
  mut count: i64 = 0
  // i from 2..=100000 → 99999 trips starting at 2
  for i_raw in 99999 {
    val i: i64 = (i_raw as i64) + 2
    mut prime: i64 = 1
    mut j: i64 = 2
    for j_raw in 400 {
      if j * j > i { break }
      if i % j == 0 {
        prime = 0
        break
      }
      j = j + 1
    }
    if prime != 0 { count = count + 1 }
  }
  suite5_print_i64(count)
  ret 0
}
