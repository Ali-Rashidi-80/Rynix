@import_c("<stdio.h>")
@import_c("<stdlib.h>")

pub fn suite5_print_i64(n: i64) void {
  val env: *u8 = getenv("SUITE5_BENCH")
  if env != (0 as *u8) {
    mut sink: i64 = 0
    sink = n
    ret
  }
  printf("%lld\n", n)
  ret
}


pub fn opaque_i64(x: i64) i64 {
  // Side-effecting getenv keeps x from being treated as a pure literal by endc/LTO.
  val env: *u8 = getenv("SUITE5_OPAQUE")
  mut v: i64 = x
  if env != (0 as *u8) {
    v = v + 1
  }
  ret v
}

pub fn main() i32 {
  val n: i64 = opaque_i64(450)
  mut s: i64 = 0
  for i_idx in n {
    val i: i64 = i_idx as i64
    for j_idx in n {
      val j: i64 = j_idx as i64
      s = s + (i * j + i) % 97
    }
  }
  suite5_print_i64(s)
  ret 0
}
