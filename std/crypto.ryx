## std.crypto — thin SHA / HMAC / AES wrappers (SPEC 6.5, Phase 28-C).
## Soft builtins remain the real ABI; these defs are import facades.

def sha256_first_i64(data: str) -> i64
  return sha256_first_i64(data)
end

def hmac_sha256_first_i64(key: str, data: str) -> i64
  return hmac_sha256_first_i64(key, data)
end

def aes128_gcm_nist_empty_tag_first_i64() -> i64
  return aes128_gcm_nist_empty_tag_first_i64()
end
